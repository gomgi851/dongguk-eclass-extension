{
  "manifest_version": 3,
  "name": "Dongguk e-Class",
  "version": "0.7.3",
  "minimum_chrome_version": "116",
  "description": "과제 제출 상태와 동영상 출석부를 읽어 남은 학습을 모아봅니다.",
  "permissions": [
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://eclass.dongguk.edu/*"
  ],
  "action": {
    "default_title": "Dongguk e-Class",
    "default_popup": "dashboard.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://eclass.dongguk.edu/course/view.php*"
      ],
      "js": [
        "course-weeks.js"
      ],
      "css": [
        "course-weeks.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://eclass.dongguk.edu/*"
      ],
      "js": [
        "site-theme.js"
      ],
      "css": [
        "site-theme.css"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
